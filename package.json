{
  "name": "smash-mate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "羽约 (SmashMate) — 羽毛球社交平台",
  "scripts": {
    "dev:server": "tsx watch server/app.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build": "npm run build:server && npm run build:web && npm run build:admin",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "DATABASE_URL=\"postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public\" vitest run",
    "test:watch": "DATABASE_URL=\"postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public\" vitest",
    "test:contracts": "DATABASE_URL=\"postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public\" vitest run tests/contracts",
    "test:integration": "DATABASE_URL=\"postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public\" vitest run tests/integration",
    "test:e2e": "DATABASE_URL=\"postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public\" playwright test",
    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=server/prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push --schema=server/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx server/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.1.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tanstack/react-query": "^5.96.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "antd": "^6.3.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "zustand": "^5.0.12"
  }
}
