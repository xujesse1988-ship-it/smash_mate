# 数据库
DATABASE_URL="postgresql://smashmate:smashmate_dev@localhost:5432/smashmate_dev?schema=public"
DATABASE_URL_TEST="postgresql://smashmate:smashmate_test@localhost:5433/smashmate_test?schema=public"

# 服务器
PORT=3000

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# 日志
LOG_LEVEL="info"

# 管理员手机号列表（逗号分隔）
ADMIN_PHONES="13800000001"

# 地图服务
MAP_API_KEY="your-map-api-key"
MAP_API_BASE_URL="https://restapi.amap.com/v3"

# 验证码配置
VERIFICATION_CODE_EXPIRE_MINUTES=5
PHONE_LOCK_DURATION_MINUTES=30
PHONE_LOCK_MAX_FAILURES=5
CODE_RESEND_INTERVAL_SECONDS=60

# 开发环境默认验证码（仅开发环境使用，生产环境请勿设置此变量）
DEV_VERIFICATION_CODE="123456"
