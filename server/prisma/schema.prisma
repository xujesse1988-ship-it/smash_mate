generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== User Module =====

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  nickname  String
  avatarUrl String?
  bio       String?
  isCoach   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activities           Activity[]
  activityParticipants ActivityParticipant[]
  coachProfile         CoachProfile?
  groupClasses         GroupClass[]
  groupClassEnrollments GroupClassEnrollment[]
  privateLessonSlots   PrivateLessonSlot[]
  privateLessonsAsCoach  PrivateLesson[]      @relation("CoachPrivateLessons")
  privateLessonsAsStudent PrivateLesson[]     @relation("StudentPrivateLessons")
  matchRecordsRecorded MatchRecord[]
  matchPlayers         MatchPlayer[]
  reviewsGiven         Review[]             @relation("ReviewerReviews")
  reviewsReceived      Review[]             @relation("CoachReviews")
  notifications        Notification[]

  // v2 新增 relations
  coachApplications       CoachApplication[]
  coachStudentClasses     StudentClass[]        @relation("CoachStudentClasses")
  studentClassMemberships StudentClassMember[]   @relation("StudentClassMemberships")
  coachClassLessons       ClassLesson[]          @relation("CoachClassLessons")
  coachPrivateStudents    PrivateStudent[]        @relation("CoachPrivateStudents")
  privateStudentRelations PrivateStudent[]        @relation("PrivateStudentRelations")
  coachPrivateLessonsV2   PrivateLessonV2[]      @relation("CoachPrivateLessonsV2")
  studentPrivateLessonsV2 PrivateLessonV2[]      @relation("StudentPrivateLessonsV2")
  coachLessonNotes        LessonNote[]           @relation("CoachLessonNotes")
  coachStudentNotes       StudentNote[]          @relation("CoachStudentNotes")
  studentNotesReceived    StudentNote[]          @relation("StudentNotesReceived")
  coachStudentTags        StudentTag[]           @relation("CoachStudentTags")
  studentTagsReceived     StudentTag[]           @relation("StudentTagsReceived")
}

model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model PhoneLock {
  id          String    @id @default(uuid())
  phone       String    @unique
  failCount   Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== Venue Module =====

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  cityId    String
  mapPoiId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city       City       @relation(fields: [cityId], references: [id])
  activities Activity[]
  groupClasses GroupClass[]
  privateLessons PrivateLesson[] @relation("VenuePrivateLessons")

  // v2 新增 relations
  classLessons     ClassLesson[]     @relation("VenueClassLessons")
  privateLessonsV2 PrivateLessonV2[] @relation("VenuePrivateLessonsV2")

  @@index([cityId])
  @@index([name])
  @@index([latitude, longitude])
}

// ===== Activity Module =====

model Activity {
  id               String   @id @default(uuid())
  creatorId        String
  venueId          String?
  title            String?
  startTime        DateTime
  endTime          DateTime
  maxParticipants  Int
  status           String   @default("open")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creator      User                  @relation(fields: [creatorId], references: [id])
  venue        Venue?                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]

  @@index([creatorId])
  @@index([status])
  @@index([startTime])
  @@index([venueId])
  @@index([status, startTime])
  @@index([status, endTime])
}

model ActivityParticipant {
  id         String   @id @default(uuid())
  activityId String
  userId     String
  joinedAt   DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@index([userId])
}

// ===== Coaching Module =====

model CoachProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  specialties String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model GroupClass {
  id              String   @id @default(uuid())
  coachId         String
  venueId         String?
  title           String
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int
  feeDescription  String?
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coach       User                   @relation(fields: [coachId], references: [id])
  venue       Venue?                 @relation(fields: [venueId], references: [id], onDelete: SetNull)
  enrollments GroupClassEnrollment[]

  @@index([coachId])
  @@index([status])
  @@index([startTime])
  @@index([venueId])
  @@index([status, startTime])
  @@index([status, endTime])
}

model GroupClassEnrollment {
  id           String   @id @default(uuid())
  groupClassId String
  userId       String
  enrolledAt   DateTime @default(now())

  groupClass GroupClass @relation(fields: [groupClassId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([groupClassId, userId])
  @@index([userId])
}

model PrivateLessonSlot {
  id             String   @id @default(uuid())
  coachId        String
  startTime      DateTime
  endTime        DateTime
  venueIds       String[] @default([])
  feeDescription String?
  isBooked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  coach         User           @relation(fields: [coachId], references: [id])
  privateLesson PrivateLesson?

  @@index([coachId])
  @@index([coachId, startTime])
}

model PrivateLesson {
  id        String   @id @default(uuid())
  slotId    String   @unique
  coachId   String
  studentId String
  venueId   String?
  startTime DateTime
  endTime   DateTime
  status    String   @default("scheduled")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slot    PrivateLessonSlot @relation(fields: [slotId], references: [id])
  coach   User              @relation("CoachPrivateLessons", fields: [coachId], references: [id])
  student User              @relation("StudentPrivateLessons", fields: [studentId], references: [id])
  venue   Venue?            @relation("VenuePrivateLessons", fields: [venueId], references: [id], onDelete: SetNull)

  @@index([coachId])
  @@index([studentId])
  @@index([status])
  @@index([status, startTime])
  @@index([status, endTime])
}

// ===== Match Record Module =====

model MatchRecord {
  id         String   @id @default(uuid())
  sourceType String
  sourceId   String
  matchType  String
  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recorder User          @relation(fields: [recordedBy], references: [id])
  players  MatchPlayer[]
  games    MatchGame[]

  @@index([sourceType, sourceId])
  @@index([recordedBy])
}

model MatchPlayer {
  id            String  @id @default(uuid())
  matchRecordId String
  side          String
  userId        String?
  guestId       String?

  matchRecord MatchRecord  @relation(fields: [matchRecordId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  guest       GuestPlayer? @relation(fields: [guestId], references: [id])

  @@index([matchRecordId])
  @@index([userId])
}

model GuestPlayer {
  id        String   @id @default(uuid())
  nickname  String
  createdAt DateTime @default(now())

  matchPlayers MatchPlayer[]
}

model MatchGame {
  id            String @id @default(uuid())
  matchRecordId String
  gameNumber    Int
  scoreA        Int
  scoreB        Int

  matchRecord MatchRecord @relation(fields: [matchRecordId], references: [id], onDelete: Cascade)

  @@unique([matchRecordId, gameNumber])
  @@index([matchRecordId])
}

// ===== Notification Module =====

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  content    String
  targetType String
  targetId   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

// ===== Review Module =====

model Review {
  id         String   @id @default(uuid())
  reviewerId String
  coachId    String
  courseType  String
  courseId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  reviewer User @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  coach    User @relation("CoachReviews", fields: [coachId], references: [id])

  @@unique([reviewerId, courseType, courseId])
  @@index([coachId])
  @@index([coachId, createdAt])
}

// ===== Coaching Module v2 Extensions =====

model CoachApplication {
  id              String   @id @default(uuid())
  userId          String
  certificateUrls String[]
  description     String?
  status          String   @default("pending") // pending | approved | rejected
  rejectReason    String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

model StudentClass {
  id        String   @id @default(uuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach    User                  @relation("CoachStudentClasses", fields: [coachId], references: [id])
  members  StudentClassMember[]
  lessons  ClassLesson[]

  @@index([coachId])
}

model StudentClassMember {
  id             String   @id @default(uuid())
  studentClassId String
  studentId      String
  joinedAt       DateTime @default(now())

  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentClassMemberships", fields: [studentId], references: [id])

  @@unique([studentClassId, studentId])
  @@index([studentId])
}

model ClassLesson {
  id              String   @id @default(uuid())
  studentClassId  String
  coachId         String
  venueId         String?
  startTime       DateTime
  endTime         DateTime
  trainingContent String?
  status          String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  coach        User         @relation("CoachClassLessons", fields: [coachId], references: [id])
  venue        Venue?       @relation("VenueClassLessons", fields: [venueId], references: [id], onDelete: SetNull)
  notes        LessonNote[] @relation("ClassLessonNotes")

  @@index([studentClassId])
  @@index([coachId])
  @@index([status])
  @@index([status, startTime])
  @@index([status, endTime])
  @@index([venueId])
}

model PrivateStudent {
  id        String   @id @default(uuid())
  coachId   String
  studentId String
  isActive  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach   User @relation("CoachPrivateStudents", fields: [coachId], references: [id])
  student User @relation("PrivateStudentRelations", fields: [studentId], references: [id])
  lessons PrivateLessonV2[]

  @@unique([coachId, studentId])
  @@index([coachId])
  @@index([studentId])
}

model PrivateLessonV2 {
  id               String   @id @default(uuid())
  privateStudentId String
  coachId          String
  studentId        String
  venueId          String?
  startTime        DateTime
  endTime          DateTime
  trainingContent  String?
  status           String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  privateStudent PrivateStudent @relation(fields: [privateStudentId], references: [id])
  coach          User           @relation("CoachPrivateLessonsV2", fields: [coachId], references: [id])
  student        User           @relation("StudentPrivateLessonsV2", fields: [studentId], references: [id])
  venue          Venue?         @relation("VenuePrivateLessonsV2", fields: [venueId], references: [id], onDelete: SetNull)
  notes          LessonNote[]   @relation("PrivateLessonV2Notes")

  @@index([privateStudentId])
  @@index([coachId])
  @@index([studentId])
  @@index([status])
  @@index([status, startTime])
  @@index([status, endTime])
  @@index([venueId])
}

model LessonNote {
  id              String   @id @default(uuid())
  classLessonId   String?
  privateLessonId String?
  coachId         String
  content         String
  createdAt       DateTime @default(now())

  classLesson   ClassLesson?   @relation("ClassLessonNotes", fields: [classLessonId], references: [id], onDelete: Cascade)
  privateLesson PrivateLessonV2? @relation("PrivateLessonV2Notes", fields: [privateLessonId], references: [id], onDelete: Cascade)
  coach         User             @relation("CoachLessonNotes", fields: [coachId], references: [id])

  @@index([classLessonId])
  @@index([privateLessonId])
  @@index([coachId])
}

model StudentNote {
  id             String   @id @default(uuid())
  coachId        String
  studentId      String
  studentClassId String?
  privateStudentId String?
  content        String
  createdAt      DateTime @default(now())

  coach          User          @relation("CoachStudentNotes", fields: [coachId], references: [id])
  student        User          @relation("StudentNotesReceived", fields: [studentId], references: [id])

  @@index([coachId, studentId])
  @@index([studentClassId])
  @@index([privateStudentId])
}

model StudentTag {
  id             String  @id @default(uuid())
  coachId        String
  studentId      String
  studentClassId String?
  privateStudentId String?
  tag            String
  createdAt      DateTime @default(now())

  coach   User @relation("CoachStudentTags", fields: [coachId], references: [id])
  student User @relation("StudentTagsReceived", fields: [studentId], references: [id])

  @@unique([coachId, studentId, studentClassId, tag])
  @@unique([coachId, studentId, privateStudentId, tag])
  @@index([coachId, studentId, studentClassId])
  @@index([coachId, studentId, privateStudentId])
}
