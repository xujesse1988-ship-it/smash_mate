generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== User Module =====

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  nickname  String
  avatarUrl String?
  bio       String?
  isCoach   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  activities              Activity[]
  activityParticipants    ActivityParticipant[]
  coachProfile            CoachProfile?
  groupClasses            GroupClass[]
  groupClassEnrollments   GroupClassEnrollment[]
  privateLessonsAsCoach   PrivateLesson[]        @relation("CoachPrivateLessons")
  privateLessonsAsStudent PrivateLesson[]        @relation("StudentPrivateLessons")
  matchRecordsRecorded    MatchRecord[]
  matchPlayers            MatchPlayer[]
  reviewsGiven            Review[]               @relation("ReviewerReviews")
  reviewsReceived         Review[]               @relation("CoachReviews")
  notifications           Notification[]

  // v2 新增 relations
  coachApplications       CoachApplication[]
  coachStudentClasses     StudentClass[]       @relation("CoachStudentClasses")
  studentClassMemberships StudentClassMember[] @relation("StudentClassMemberships")
  coachClassLessons       ClassLesson[]        @relation("CoachClassLessons")
  coachStudents           CoachStudent[]       @relation("CoachStudents")
  studentOfCoaches        CoachStudent[]       @relation("StudentOfCoaches")
  coachLessonNotes        LessonNote[]         @relation("CoachLessonNotes")
  coachStudentNotes       StudentNote[]        @relation("CoachStudentNotes")
  studentNotesReceived    StudentNote[]        @relation("StudentNotesReceived")
  coachStudentTags        StudentTag[]         @relation("CoachStudentTags")
  studentTagsReceived     StudentTag[]         @relation("StudentTagsReceived")
}

model VerificationCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model PhoneLock {
  id          String    @id @default(uuid())
  phone       String    @unique
  failCount   Int       @default(0)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ===== Venue Module =====

model City {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues Venue[]
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  cityId    String
  mapPoiId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city           City            @relation(fields: [cityId], references: [id])
  activities     Activity[]
  groupClasses   GroupClass[]
  privateLessons PrivateLesson[]

  // v2 新增 relations
  classLessons ClassLesson[] @relation("VenueClassLessons")

  @@index([cityId])
  @@index([name])
  @@index([latitude, longitude])
}

// ===== Activity Module =====

model Activity {
  id              String   @id @default(uuid())
  creatorId       String
  venueId         String?
  title           String?
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator      User                  @relation(fields: [creatorId], references: [id])
  venue        Venue?                @relation(fields: [venueId], references: [id], onDelete: SetNull)
  participants ActivityParticipant[]

  @@index([creatorId])
  @@index([status])
  @@index([startTime])
  @@index([venueId])
  @@index([status, startTime])
  @@index([status, endTime])
}

model ActivityParticipant {
  id         String   @id @default(uuid())
  activityId String
  userId     String
  joinedAt   DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@index([userId])
}

// ===== Coaching Module =====

model CoachProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  bio         String?
  specialties String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model GroupClass {
  id              String   @id @default(uuid())
  coachId         String
  venueId         String?
  title           String
  startTime       DateTime
  endTime         DateTime
  maxParticipants Int
  feeDescription  String?
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coach       User                   @relation(fields: [coachId], references: [id])
  venue       Venue?                 @relation(fields: [venueId], references: [id], onDelete: SetNull)
  enrollments GroupClassEnrollment[]

  @@index([coachId])
  @@index([status])
  @@index([startTime])
  @@index([venueId])
  @@index([status, startTime])
  @@index([status, endTime])
}

model GroupClassEnrollment {
  id           String   @id @default(uuid())
  groupClassId String
  userId       String
  enrolledAt   DateTime @default(now())

  groupClass GroupClass @relation(fields: [groupClassId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([groupClassId, userId])
  @@index([userId])
}

// 统一 PrivateLesson：合并原 PrivateLesson + PrivateLessonV2 + PrivateLessonSlot
// status 枚举：scheduled | in_progress | completed | cancelled | expired
// 语义：
//   - studentId=null & source=null  → 教练开放的空闲时段（未被预约）
//   - studentId!=null & source='booked'    → 学员预约
//   - studentId!=null & source='scheduled' → 教练直接对学员排课
model PrivateLesson {
  id              String   @id @default(uuid())
  coachId         String
  studentId       String?
  venueId         String?
  venueIds        String[] @default([])
  startTime       DateTime
  endTime         DateTime
  feeDescription  String?
  trainingContent String?
  source          String?
  status          String   @default("scheduled")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  coach   User         @relation("CoachPrivateLessons", fields: [coachId], references: [id])
  student User?        @relation("StudentPrivateLessons", fields: [studentId], references: [id])
  venue   Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  notes   LessonNote[]

  @@index([coachId, status])
  @@index([studentId, status])
  @@index([status, startTime])
  @@index([coachId, studentId])
}

// ===== Match Record Module =====

model MatchRecord {
  id         String   @id @default(uuid())
  sourceType String
  sourceId   String
  matchType  String
  recordedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recorder User          @relation(fields: [recordedBy], references: [id])
  players  MatchPlayer[]
  games    MatchGame[]

  @@index([sourceType, sourceId])
  @@index([recordedBy])
}

model MatchPlayer {
  id            String  @id @default(uuid())
  matchRecordId String
  side          String
  userId        String?
  guestId       String?

  matchRecord MatchRecord  @relation(fields: [matchRecordId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  guest       GuestPlayer? @relation(fields: [guestId], references: [id])

  @@index([matchRecordId])
  @@index([userId])
}

model GuestPlayer {
  id        String   @id @default(uuid())
  nickname  String
  createdAt DateTime @default(now())

  matchPlayers MatchPlayer[]
}

model MatchGame {
  id            String @id @default(uuid())
  matchRecordId String
  gameNumber    Int
  scoreA        Int
  scoreB        Int

  matchRecord MatchRecord @relation(fields: [matchRecordId], references: [id], onDelete: Cascade)

  @@unique([matchRecordId, gameNumber])
  @@index([matchRecordId])
}

// ===== Notification Module =====

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  content    String
  targetType String
  targetId   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([createdAt])
}

// ===== Review Module =====

model Review {
  id         String   @id @default(uuid())
  reviewerId String
  coachId    String
  courseType String
  courseId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  reviewer User @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  coach    User @relation("CoachReviews", fields: [coachId], references: [id])

  @@unique([reviewerId, courseType, courseId])
  @@index([coachId])
  @@index([coachId, createdAt])
}

// ===== Coaching Module v2 Extensions =====

model CoachApplication {
  id              String    @id @default(uuid())
  userId          String
  certificateUrls String[]
  description     String?
  status          String    @default("pending") // pending | approved | rejected
  rejectReason    String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

model StudentClass {
  id        String   @id @default(uuid())
  coachId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach   User                 @relation("CoachStudentClasses", fields: [coachId], references: [id])
  members StudentClassMember[]
  lessons ClassLesson[]

  @@index([coachId])
}

model StudentClassMember {
  id             String   @id @default(uuid())
  studentClassId String
  studentId      String
  joinedAt       DateTime @default(now())

  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  student      User         @relation("StudentClassMemberships", fields: [studentId], references: [id])

  @@unique([studentClassId, studentId])
  @@index([studentId])
}

model ClassLesson {
  id              String   @id @default(uuid())
  studentClassId  String
  coachId         String
  venueId         String?
  startTime       DateTime
  endTime         DateTime
  trainingContent String?
  status          String   @default("scheduled") // scheduled | in_progress | completed | cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentClass StudentClass @relation(fields: [studentClassId], references: [id], onDelete: Cascade)
  coach        User         @relation("CoachClassLessons", fields: [coachId], references: [id])
  venue        Venue?       @relation("VenueClassLessons", fields: [venueId], references: [id], onDelete: SetNull)
  notes        LessonNote[] @relation("ClassLessonNotes")

  @@index([studentClassId])
  @@index([coachId])
  @@index([status])
  @@index([status, startTime])
  @@index([status, endTime])
  @@index([venueId])
}

// 教练统一学员库：教练与学员的关系，按 (coachId, studentId) 唯一
// source 只记首次成为学员的来源：'manual' | 'group-class' | 'private-lesson' | 'class-lesson'
model CoachStudent {
  id         String   @id @default(uuid())
  coachId    String
  studentId  String
  source     String
  firstMetAt DateTime @default(now())
  createdAt  DateTime @default(now())

  coach   User @relation("CoachStudents", fields: [coachId], references: [id])
  student User @relation("StudentOfCoaches", fields: [studentId], references: [id])

  @@unique([coachId, studentId])
  @@index([coachId])
  @@index([studentId])
}

model LessonNote {
  id              String   @id @default(uuid())
  classLessonId   String?
  privateLessonId String?
  coachId         String
  content         String
  createdAt       DateTime @default(now())

  classLesson   ClassLesson?   @relation("ClassLessonNotes", fields: [classLessonId], references: [id], onDelete: Cascade)
  privateLesson PrivateLesson? @relation(fields: [privateLessonId], references: [id], onDelete: Cascade)
  coach         User           @relation("CoachLessonNotes", fields: [coachId], references: [id])

  @@index([classLessonId])
  @@index([privateLessonId])
  @@index([coachId])
}

model StudentNote {
  id             String   @id @default(uuid())
  coachId        String
  studentId      String
  studentClassId String?
  content        String
  createdAt      DateTime @default(now())

  coach   User @relation("CoachStudentNotes", fields: [coachId], references: [id])
  student User @relation("StudentNotesReceived", fields: [studentId], references: [id])

  @@index([coachId, studentId])
  @@index([studentClassId])
}

model StudentTag {
  id        String   @id @default(uuid())
  coachId   String
  studentId String
  tag       String
  createdAt DateTime @default(now())

  coach   User @relation("CoachStudentTags", fields: [coachId], references: [id])
  student User @relation("StudentTagsReceived", fields: [studentId], references: [id])

  @@unique([coachId, studentId, tag])
  @@index([coachId, studentId])
}
